tem_85_6 <- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/HadGem3_585/2050/Tmed/Tmed_mes/Tmed85_06.tif")
tem_85_7 <- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/HadGem3_585/2050/Tmed/Tmed_mes/Tmed85_07.tif")
tem_85_8 <- rast("C:/Sevilla/UCV/Oscar/FAO_Cambiocliamtico2026/Coberturas/Raster/Capas_Raster_Clima/Base_Climatica/HadGem3_585/2050/Tmed/Tmed_mes/Tmed85_08.tif")
# promedio del ciclo (mayo a gosto):
tem_h <- ((tem_h_5 + tem_h_6 + tem_h_7 + tem_h_8) / 4 )
tem_45 <- ((tem_45_5 + tem_45_6 + tem_45_7 + tem_45_8) / 4)
tem_85 <- ((tem_85_5 + tem_85_6 + tem_85_7 + tem_85_8) / 4)
par(mfrow=c(2,2))
plot(tem_h)
plot(tem_45)
plot(tem_85)
summary(tem_h); summary(tem_45); summary(tem_85)
tem_maiz <- tibble(
tem = c(0, 14, 16, 18, 25, 32, 35, 40, 45),
g_aptitud = c(0, 1, 2, 3, 4, 3, 2, 1, 0)
)
tem_maiz1 <- tem_maiz %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (tem - lag(tem)),
intercepto = g_aptitud - (pendiente * tem)
)
print(tem_maiz1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
temlim_14  <- tem_maiz1$tem[2]
temlim_16 <- tem_maiz1$tem[3]
temlim_18 <- tem_maiz1$tem[4]
temlim_25 <- tem_maiz1$tem[5]
temlim_32 <- tem_maiz1$tem[6]
temlim_35 <- tem_maiz1$tem[7]
temlim_40 <- tem_maiz1$tem[8]
temlim_45 <- tem_maiz1$tem[9]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
temm14  <- tem_maiz1$pendiente[2]
temb14  <- tem_maiz1$intercepto[2]
temm16 <- tem_maiz1$pendiente[3]
temb16 <- tem_maiz1$intercepto[3]
temm18 <- tem_maiz1$pendiente[4]
temb18 <- tem_maiz1$intercepto[4]
temm25 <- tem_maiz1$pendiente[5]
temb25 <- tem_maiz1$intercepto[5]
temm32 <- tem_maiz1$pendiente[6]
temb32 <- tem_maiz1$intercepto[6]
temm35 <- tem_maiz1$pendiente[7]
temb35 <- tem_maiz1$intercepto[7]
temm40 <- tem_maiz1$pendiente[8]
temb40 <- tem_maiz1$intercepto[8]
temm45 <- tem_maiz1$pendiente[9]
temb45 <- tem_maiz1$intercepto[9]
tem_h_a <- ifel(tem_h < temlim_14,  (temm14  * tem_h) + temb14,
ifel(tem_h < temlim_16, (temm16 * tem_h) + temb16,
ifel(tem_h < temlim_18, (temm18 * tem_h) + temb18,
ifel(tem_h < temlim_25, (temm25 * tem_h) + temb25,
ifel(tem_h < temlim_32, (temm32 * tem_h) + temb32,
ifel(tem_h < temlim_35,(temm35 * tem_h) + temb35,
ifel(tem_h < temlim_40,(temm40 * tem_h) + temb40,
ifel(tem_h < temlim_45,(temm45 * tem_h) + temb45, NA))))))))
tem_45_a <- ifel(tem_45 < temlim_14,  (temm14  * tem_45) + temb14,
ifel(tem_45 < temlim_16, (temm16 * tem_45) + temb16,
ifel(tem_45 < temlim_18, (temm18 * tem_45) + temb18,
ifel(tem_45 < temlim_25, (temm25 * tem_45) + temb25,
ifel(tem_45 < temlim_32, (temm32 * tem_45) + temb32,
ifel(tem_45 < temlim_35,(temm35 * tem_45) + temb35,
ifel(tem_45 < temlim_40,(temm40 * tem_45) + temb40,
ifel(tem_45 < temlim_45,(temm45 * tem_45) + temb45, NA))))))))
tem_85_a <- ifel(tem_85 < temlim_14,  (temm14  * tem_85) + temb14,
ifel(tem_85 < temlim_16, (temm16 * tem_85) + temb16,
ifel(tem_85 < temlim_18, (temm18 * tem_85) + temb18,
ifel(tem_85 < temlim_25, (temm25 * tem_85) + temb25,
ifel(tem_85 < temlim_32, (temm32 * tem_85) + temb32,
ifel(tem_85 < temlim_35,(temm35 * tem_85) + temb35,
ifel(tem_85 < temlim_40,(temm40 * tem_85) + temb40,
ifel(tem_85 < temlim_45,(temm45 * tem_85) + temb45, NA))))))))
# Impresion de las capas:
par(mfrow=c(3,2))
# Impresion de las capas:
par(mfrow=c(2,2))
plot(tem_h_a,col = paleta_semaforo(100),main = "Aptitud por Temperatura media del ciclo Historico")
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1.5)
plot(tem_45_a,col = paleta_semaforo(100),main = "Aptitud por Temperatura media del ciclo Historico")
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1.5)
plot(tem_85_a,col = paleta_semaforo(100),main = "Aptitud por Temperatura media del ciclo SSP2 4.5")
