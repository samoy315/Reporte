tam_mc <- tibble(
tam_mc = c(0, 21, 26, 30, 35, 40, 45, 50, 55),
g_aptitud = c(0, 1, 2, 3, 4, 3, 2, 1, 0)
)
tam_mc1 <- tam_mc %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (tam_mc - lag(tam_mc)),
intercepto = g_aptitud - (pendiente * tam_mc)
)
print(tam_mc1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
tamclim_21  <- tam_mc1$tam_mc[2]
tamclim_26 <- tam_mc1$tam_mc[3]
tamclim_30 <- tam_mc1$tam_mc[4]
tamclim_35 <- tam_mc1$tam_mc[5]
tamclim_40 <- tam_mc1$tam_mc[6]
tamclim_45 <- tam_mc1$tam_mc[7]
tamclim_50 <- tam_mc1$tam_mc[8]
tamclim_55 <- tam_mc1$tam_mc[9]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
tamcm21  <- tam_mc1$pendiente[2]
tamcb21  <- tam_mc1$intercepto[2]
tamcm26 <- tam_mc1$pendiente[3]
tamcb26 <- tam_mc1$intercepto[3]
tamcm30 <- tam_mc1$pendiente[4]
tamcb30 <- tam_mc1$intercepto[4]
tamcm35 <- tam_mc1$pendiente[5]
tamcb35 <- tam_mc1$intercepto[5]
tamcm40 <- tam_mc1$pendiente[6]
tamcb40 <- tam_mc1$intercepto[6]
tamcm45 <- tam_mc1$pendiente[7]
tamcb45 <- tam_mc1$intercepto[7]
tamcm50 <- tam_mc1$pendiente[8]
tamcb50 <- tam_mc1$intercepto[8]
tamcm55 <- tam_mc1$pendiente[9]
tamcb55 <- tam_mc1$intercepto[9]
