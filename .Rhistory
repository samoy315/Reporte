timb28 <- tim_arroz1$intercepto[7]
timm30 <- tim_arroz1$pendiente[8]
timb30 <- tim_arroz1$intercepto[8]
timm32 <- tim_arroz1$pendiente[9]
timb32 <- tim_arroz1$intercepto[9]
