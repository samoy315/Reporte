plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1.5)
plot(tim_45_a,col = paleta_semaforo(4),main = "Aptitud por Temperatura minima media del ciclo | SSP2-4.5")
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1.5)
plot(tim_85_a,col = paleta_semaforo(4),main = "Aptitud por Temperatura minima media del ciclo | SSP5-8.5")
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1.5)
