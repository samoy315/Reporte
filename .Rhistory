timlim_25 <- tim_arroz1$tim[6]
timlim_28 <- tim_arroz1$tim[7]
timlim_30 <- tim_arroz1$tim[8]
timlim_32 <- tim_arroz1$tim[9]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
