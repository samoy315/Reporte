tim_maiz <- tibble(
tim = c(0, 7, 9, 12, 18, 24, 28, 30, 32),
g_aptitud = c(0, 1, 2, 3, 4, 3, 2, 1, 0)
)
tim_maiz1 <- tim_maiz %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (tim - lag(tim)),
intercepto = g_aptitud - (pendiente * tim)
)
print(tim_maiz1)
# Extraemos los límites de precipitación de su columna
# Nota: Saltamos la fila 3 (1000) porque la pendiente e intercepto son iguales
# a los de la fila 4 (1200), así que el umbral < 1200 cubre ambos tramos.
timlim_07  <- tim_maiz1$tim[2]
timlim_09 <- tim_maiz1$tim[3]
timlim_12 <- tim_maiz1$tim[4]
timlim_18 <- tim_maiz1$tim[5]
timlim_24 <- tim_maiz1$tim[6]
timlim_28 <- tim_maiz1$tim[7]
timlim_30 <- tim_maiz1$tim[8]
timlim_32 <- tim_maiz1$tim[9]
# Extraemos pendientes (m) e interceptos (b) de las mismas filas
timm07  <- tim_maiz1$pendiente[2]
timb07  <- tim_maiz1$intercepto[2]
timm09 <- tim_maiz1$pendiente[3]
timb09 <- tim_maiz1$intercepto[3]
timm12 <- tim_maiz1$pendiente[4]
timb12 <- tim_maiz1$intercepto[4]
timm18 <- tim_maiz1$pendiente[5]
timb18 <- tim_maiz1$intercepto[5]
timm24 <- tim_maiz1$pendiente[6]
timb24 <- tim_maiz1$intercepto[6]
timm28 <- tim_maiz1$pendiente[7]
timb28 <- tim_maiz1$intercepto[7]
timm30 <- tim_maiz1$pendiente[8]
timb30 <- tim_maiz1$intercepto[8]
timm32 <- tim_maiz1$pendiente[9]
timb32 <- tim_maiz1$intercepto[9]
# Calculamos el nuevo raster con todo 100% parametrizado  ------ Ciclo 0508 ------------------------------------------
tim_h_b <- ifel(tim_h_a < timlim_07,  (timm07  * tim_h_a) + timb07,
ifel(tim_h_a < timlim_09, (timm09 * tim_h_a) + timb09,
ifel(tim_h_a < timlim_12, (timm12 * tim_h_a) + timb12,
ifel(tim_h_a < timlim_18, (timm18 * tim_h_a) + timb18,
ifel(tim_h_a < timlim_24, (timm24 * tim_h_a) + timb24,
ifel(tim_h_a < timlim_28,(timm28 * tim_h_a) + timb28,
ifel(tim_h_a < timlim_30,(timm30 * tim_h_a) + timb30,
ifel(tim_h_a <= timlim_32,(timm32 * tim_h_a) + timb32, NA))))))))
tim_45_a <- ifel(tim_45 < timlim_07,  (timm07  * tim_45) + timb07,
ifel(tim_45 < timlim_09, (timm09 * tim_45) + timb09,
ifel(tim_45 < timlim_12, (timm12 * tim_45) + timb12,
ifel(tim_45 < timlim_18, (timm18 * tim_45) + timb18,
ifel(tim_45 < timlim_24, (timm24 * tim_45) + timb24,
ifel(tim_45 < timlim_28,(timm28 * tim_45) + timb28,
ifel(tim_45 < timlim_30,(timm30 * tim_45) + timb30,
ifel(tim_45 <= timlim_32,(timm32 * tim_45) + timb32, NA))))))))
tim_85_a <- ifel(tim_85 < timlim_07,  (timm07  * tim_85) + timb07,
ifel(tim_85 < timlim_09, (timm09 * tim_85) + timb09,
ifel(tim_85 < timlim_12, (timm12 * tim_85) + timb12,
ifel(tim_85 < timlim_18, (timm18 * tim_85) + timb18,
ifel(tim_85 < timlim_24, (timm24 * tim_85) + timb24,
ifel(tim_85 < timlim_28,(timm28 * tim_85) + timb28,
ifel(tim_85 < timlim_30,(timm30 * tim_85) + timb30,
ifel(tim_85 <= timlim_32,(timm32 * tim_85) + timb32, NA))))))))
par(mfrow=c(3,2))
plot(tim_h_b,col = paleta_semaforo(4),main = "ptitud por Temperatura minima media del ciclo | Historico")
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1.5)
plot(tim_45_a,col = paleta_semaforo(4),main = "Aptitud por Temperatura minima media del ciclo | SSP2-4.5")
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1.5)
plot(tim_85_a,col = paleta_semaforo(4),main = "Aptitud por Temperatura minima media del ciclo | SSP5-8.5")
plot(st_geometry(venezuela),add = TRUE,border = "black",lwd = 1.5)
par(mfrow=c(2,2))
