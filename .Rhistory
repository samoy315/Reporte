g_aptitud = c(0, 1, 2, 3, 4, 3, 2, 1)
)
hrlv_arroz1 <- hrlv_arroz %>%
mutate(
pendiente = (g_aptitud - lag(g_aptitud)) / (hrlv - lag(hrlv)),
intercepto = g_aptitud - (pendiente * hrlv)
)
print(hrlv_arroz1)
# Extraemos los límites de precipitación de su columna
